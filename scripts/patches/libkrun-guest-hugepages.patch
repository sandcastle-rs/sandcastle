diff --git a/src/vmm/src/builder.rs b/src/vmm/src/builder.rs
index 72831f1..680316a 100644
--- a/src/vmm/src/builder.rs
+++ b/src/vmm/src/builder.rs
@@ -1512,11 +1512,25 @@ pub fn create_guest_memory(
             .map_err(StartMicrovmError::ShmCreate)?;
     }
 
+    let ram_regions = arch_mem_regions.len();
     arch_mem_regions.extend(shm_manager.regions());
 
     let guest_mem = GuestMemoryMmap::from_ranges(&arch_mem_regions)
         .map_err(|e| StartMicrovmError::GuestMemoryMmap(format!("{e:?}")))?;
 
+    // Ask for transparent huge pages on guest RAM, which hosts with THP in
+    // "madvise" mode (the common default) otherwise back with 4 KiB pages.
+    // The guest kernel initializes its page metadata across all of RAM at
+    // boot, so every 4 KiB host fault there adds up to milliseconds per GiB.
+    #[cfg(target_os = "linux")]
+    for &(start, len) in &arch_mem_regions[..ram_regions] {
+        if let Ok(addr) = vm_memory::GuestMemory::get_host_address(&guest_mem, start) {
+            // SAFETY: `addr..addr + len` is one region `guest_mem` mapped above.
+            // The advice is a hint; on failure the region keeps small pages.
+            unsafe { libc::madvise(addr.cast(), len, libc::MADV_HUGEPAGE) };
+        }
+    }
+
     let (guest_mem, entry_addr, initrd_config, cmdline) =
         load_payload(vm_resources, guest_mem, &arch_mem_info, payload)?;
 
